{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5436;Database=k2agents;Username=k2agents;Password=defina_no_user_secrets_ou_env"
  },
  "Database": {
    "MigrateOnStartup": true,
    "Seed": true
  },
  "Swagger": {
    "Enabled": true
  },
  "Retention": {
    "Enabled": true,
    "IntervalHours": 24
  },
  "RateLimiting": {
    "AuthPerMinute": 10,
    "SessionPerMinute": 120,
    "AIPerMinute": 20,
    "WebChatPerMinute": 40,
    "GlobalPerMinute": 600
  },
  "Cors": {
    "Origins": [ "http://localhost:4200", "http://localhost:4310" ]
  },
  "AI": {
    "OpenAI": {
      "ApiKey": "",
      "BaseUrl": "https://api.openai.com/v1/",
      "DefaultModel": "gpt-4o-mini",
      "TimeoutSeconds": 30,
      "MaxRetries": 1
    },
    "Limits": {
      "DailyRequestsPerCompany": 500,
      "DailyTokensPerCompany": 300000,
      "MaxHistoryTokens": 3000,
      "MaxMessageChars": 2000,
      "MaxReplyChars": 4000
    },
    "Models": [
      { "Id": "gpt-4o-mini", "Label": "GPT-4o mini", "Provider": "OpenAI", "InputPricePer1M": 0.15, "OutputPricePer1M": 0.60, "IsDefault": true },
      { "Id": "gpt-4.1-mini", "Label": "GPT-4.1 mini", "Provider": "OpenAI", "InputPricePer1M": 0.40, "OutputPricePer1M": 1.60, "IsDefault": false },
      { "Id": "gpt-4o", "Label": "GPT-4o", "Provider": "OpenAI", "InputPricePer1M": 2.50, "OutputPricePer1M": 10.00, "IsDefault": false },
      { "Id": "gpt-4.1", "Label": "GPT-4.1", "Provider": "OpenAI", "InputPricePer1M": 2.00, "OutputPricePer1M": 8.00, "IsDefault": false }
    ]
  },
  "Knowledge": {
    "MaxFileSizeBytes": 10485760,
    "MaxTextChars": 200000,
    "MaxPdfPages": 300,
    "MaxContextChars": 3000,
    "MaxSnippets": 4
  },
  "Storage": {
    "RootPath": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "Fatal",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
