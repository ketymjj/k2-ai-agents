# Copie para .env e preencha — ou gere automaticamente com segredos aleatórios:
#   Windows:  powershell -ExecutionPolicy Bypass -File scripts/setup-env.ps1
#   Linux/macOS/Git Bash:  sh scripts/setup-env.sh
# O arquivo .env NUNCA deve ser versionado.

# --- PostgreSQL ---
POSTGRES_DB=k2agents
POSTGRES_USER=k2agents
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_PORT=5436

# --- API ---
ASPNETCORE_ENVIRONMENT=Production
API_PORT=5100
# Mínimo de 32 caracteres aleatórios (ex.: openssl rand -base64 48). Obrigatório.
JWT_SECRET=troque_por_um_segredo_aleatorio_com_mais_de_32_caracteres
# Chave AES-256 dos segredos de canais (token do WhatsApp): 32 bytes em Base64 (openssl rand -base64 32). Obrigatória.
# Trocar esta chave torna ilegíveis as credenciais já salvas (será preciso informá-las de novo).
SECRETS_ENCRYPTION_KEY=troque_por_32_bytes_em_base64
SEED_DEMO_DATA=true
# Senhas dos usuários criados pelo seed (aplicadas só na primeira carga, com o banco vazio).
# Obrigatórias fora de Development: a API não cria usuários com senha padrão pública.
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=
SWAGGER_ENABLED=true

# --- Provedor de IA (opcional) ---
# Sem chave, Playground e Web Chat usam o modo demonstrativo (respostas identificadas como SIMULADAS);
# no WhatsApp, sem chave, as conversas vão direto para a equipe.
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# --- Frontend ---
WEB_PORT=4310
